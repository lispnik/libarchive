;;; The man page and shell completions, generated from the command
;;; definitions so they cannot drift from them: `make docs' writes them to
;;; bin/, and the release tarballs and the Homebrew formula install them.

(in-package #:libarchive/cli)

(defparameter *bash-completion*
  "# bash completion for la. Generated by libarchive/cli; source it, or install
# it as la in a bash-completion directory.
#
# la itself says what can follow: the subcommands and options of the command
# line so far (clingon's --bash-completions). Anything else completes as a
# file name, since that is what most arguments are.

_la() {
    local cur=${COMP_WORDS[COMP_CWORD]}
    local suggestions
    suggestions=$(\"${COMP_WORDS[@]:0:COMP_CWORD}\" --bash-completions 2>/dev/null) || return
    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W \"$(grep -E '^-' <<<\"$suggestions\")\" -- \"$cur\"))
    elif [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W \"$(grep -vE '^-' <<<\"$suggestions\")\" -- \"$cur\"))
    fi
}
complete -o bashdefault -o default -F _la la
")

;;; The man page. clingon has an mdoc printer, but it signals a FORMAT error
;;; on any command with aliases; this one also says what la's environment
;;; variables and exit codes are.

(defun mdoc-text (string)
  "STRING as mdoc text lines: backslashes escaped, and no line starting with
a dot or quote (which would be read as a macro)."
  (with-output-to-string (out)
    (dolist (line (uiop:split-string (string-trim '(#\Newline) string) :separator '(#\Newline)))
      (let ((line (string-trim " " (with-output-to-string (l)
                                     (loop for c across line
                                           do (if (char= c #\\) (write-string "\\e" l) (write-char c l)))))))
        (cond ((zerop (length line)) (format out ".Pp~%"))
              ((find (char line 0) ".'") (format out "\\&~A~%" line))
              (t (format out "~A~%" line)))))))

(defun documented-options (command)
  (remove-if (lambda (o)
               (or (clingon:option-hidden-p o)
                   (search "CLINGON." (symbol-name (clingon:option-key o)))))
             (clingon:command-options command)))

(defun write-man-page (top stream)
  (format stream ".Dd ~A~%.Dt LA 1~%.Os~%" (multiple-value-bind (s m h d mo y) (get-decoded-time)
                                               (declare (ignore s m h))
                                               (format nil "~[~;January~;February~;March~;April~;May~;June~;July~;August~;September~;October~;November~;December~] ~D, ~D" mo d y)))
  (format stream ".Sh NAME~%.Nm la~%.Nd ~A~%" (clingon:command-description top))
  (format stream ".Sh SYNOPSIS~%")
  (dolist (sub (clingon:command-sub-commands top))
    (format stream ".Nm~%.Cm ~A~%.Ar ~A~%" (clingon:command-name sub)
            (clingon:command-usage sub)))
  ;; The long description starts with a table of the commands: kept as laid out.
  (let* ((text (clingon:command-long-description top))
         (split (search (format nil "~%~%") text)))
    (format stream ".Sh DESCRIPTION~%.Bd -literal -offset indent~%~A.Ed~%.Pp~%~A"
            (mdoc-text (subseq text 0 split))
            (if split (mdoc-text (subseq text split)) "")))
  (format stream ".Sh COMMANDS~%")
  (dolist (sub (clingon:command-sub-commands top))
    (format stream ".Ss ~A~@[ (~{~A~^, ~})~]~%" (clingon:command-name sub) (clingon:command-aliases sub))
    (format stream ".Nm~%.Cm ~A~%.Ar ~A~%.Pp~%~A~@[.Pp~%~A~]" (clingon:command-name sub)
            (clingon:command-usage sub) (mdoc-text (clingon:command-description sub))
            (and (clingon:command-long-description sub)
                 (mdoc-text (clingon:command-long-description sub))))
    (let ((options (documented-options sub)))
      (when options
        (format stream ".Bl -tag -width Ds~%")
        (dolist (o options)
          (format stream ".It ~@[Fl ~A~]~:[~; , ~]~@[Fl -~A~]~@[ Ar ~A~]~%~A"
                  (clingon:option-short-name o)
                  (and (clingon:option-short-name o) (clingon:option-long-name o))
                  (clingon:option-long-name o)
                  (clingon:option-parameter o)
                  (mdoc-text (clingon:option-description o))))
        (format stream ".El~%"))))
  (format stream "~A" "\
.Sh ENVIRONMENT
.Bl -tag -width Ds
.It Ev LA_PASSPHRASE
The passphrase, when
.Fl p
is not given. Without either, an encrypted archive is asked for on the
terminal.
.It Ev LA_LIBARCHIVE
.Cm system
uses the installed libarchive instead of the one built into release
binaries; a file name uses that file.
.It Ev LA_DEBUG
Print a backtrace on unexpected errors.
.El
.Sh EXIT STATUS
0 for success, 1 when something failed (including an entry that could not be
extracted, or a difference found by
.Cm diff ) ,
and 2 for a usage error.
.Sh EXAMPLES
.Bd -literal -offset indent
la a site.tar.zst site/ README.md
la a -r site.tar.zst site/index.html
la x download.tar.gz
la x src.tar.gz 'src/*.c'
la x -x '*.o' --newer 2025-01-01 build.tar.gz
la convert photos.zip photos.tar.zst
la l --json release.7z
la rm site.tar.zst site/drafts
la cat logs.zip app.log | less
la diff backup.tar.gz -C ~/project
.Ed
.Sh SEE ALSO
.Xr bsdtar 1 ,
.Xr libarchive 3
.Pp
.Lk https://github.com/lispnik/libarchive
"))

;;; zsh. clingon writes a completion function too, but with multi-line
;;; descriptions in the command menu and no file names for arguments, which is
;;; what most of la's arguments are.

(defun first-line (string)
  (let ((line (subseq string 0 (position #\Newline string))))
    (string-right-trim ".:" line)))

(defun zsh-quote (string)
  "STRING inside a single-quoted zsh word, with brackets escaped for _arguments."
  (with-output-to-string (out)
    (loop for c across string
          do (case c
               (#\' (write-string "'\\''" out))
               ((#\[ #\]) (write-char #\\ out) (write-char c out))
               (t (write-char c out))))))

(defun zsh-option-spec (o)
  (let* ((short (and (clingon:option-short-name o) (format nil "-~A" (clingon:option-short-name o))))
         (long (and (clingon:option-long-name o) (format nil "--~A" (clingon:option-long-name o))))
         (names (if (and short long) (format nil "{~A,~A}" short long) (or short long)))
         (parameter (clingon:option-parameter o)))
    (format nil "~A'[~A]~@[:~A:~A~]'" names (zsh-quote (first-line (clingon:option-description o)))
            parameter
            (if (equal parameter "DIR") "_files -/" " "))))

(defun write-zsh-completion (top stream)
  (format stream "#compdef la~%# zsh completion for la. Generated by libarchive/cli; install it as _la~%~
                  # in a directory on $fpath.~%~%_la() {~%    local line state~%~
                  ~4T_arguments -C '--help[display usage information and exit]' \\~%~
                  ~15T'--version[display version and exit]' '1: :->cmds' '*::arg:->args'~%~
                  ~4Tcase $state in~%~8Tcmds)~%~12T_values 'la command' \\~%")
  (dolist (sub (clingon:command-sub-commands top))
    (dolist (name (cons (clingon:command-name sub) (clingon:command-aliases sub)))
      (format stream "~16T'~A[~A]' \\~%" name (zsh-quote (first-line (clingon:command-description sub))))))
  (format stream "~16T;;~%~8Targs)~%~12Tcase $line[1] in~%")
  (dolist (sub (clingon:command-sub-commands top))
    (format stream "~16T~{~A~^|~})~%~20T_arguments -S -s \\~%"
            (cons (clingon:command-name sub) (clingon:command-aliases sub)))
    (dolist (o (documented-options sub))
      (format stream "~24T~A \\~%" (zsh-option-spec o)))
    (format stream "~24T'*:file:_files' ;;~%"))
  (format stream "~12Tesac ;;~%~4Tesac~%}~%~%_la \"$@\"~%"))

(defun write-docs (directory)
  "Write la.1 (mdoc), _la (zsh) and la.bash into DIRECTORY."
  (let ((directory (uiop:ensure-directory-pathname directory))
        (top (top-level-command :libarchive-details nil)))
    (ensure-directories-exist directory)
    (flet ((write-to (name function)
             (with-open-file (s (merge-pathnames name directory)
                                :direction :output :if-exists :supersede)
               (funcall function s))))
      (write-to "la.1" (lambda (s) (write-man-page top s)))
      (write-to "_la" (lambda (s) (write-zsh-completion top s)))
      (write-to "la.bash" (lambda (s) (write-string *bash-completion* s))))
    directory))
