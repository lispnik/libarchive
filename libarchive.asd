;;; CFFI bindings to libarchive: a complete raw layer plus an ergonomic one.
;;;
;;;   libarchive/ffi    every function in archive.h and archive_entry.h and
;;;                     every integer ARCHIVE_*/AE_* macro, generated by
;;;                     tools/gen-ffi.py. cffi only, and it loads on a machine
;;;                     with no libarchive installed: DEFCFUN resolves lazily
;;;                     and nothing runs at load time.
;;;   libarchive        readers, writers, entries, extraction to disk and
;;;                     archiving from disk; reading from and writing to Lisp
;;;                     streams and octet vectors.
;;;   libarchive/tests  FiveAM.
;;;
;;; There is no libarchive/closures, and no cffi-callback-closures dependency:
;;; every callback libarchive takes is paired with a void* of client data, so a
;;; fixed set of DEFCALLBACKs demultiplexes on that pointer (src/registry.lisp)
;;; and runtime-minted closures are never needed.

(asdf:defsystem #:libarchive/ffi
  :description "Complete raw CFFI bindings to libarchive."
  :license     "MIT"
  :version     "0.3.1"
  :depends-on  (#:cffi #:babel #:bordeaux-threads)
  :components ((:module "src"
                :components ((:file "package")
                             (:file "library"     :depends-on ("package"))
                             (:file "types"       :depends-on ("package"))
                             (:file "conditions"  :depends-on ("package"))
                             ;; Generated.
                             (:file "constants"   :depends-on ("package"))
                             (:file "ffi-names"   :depends-on ("package"))
                             (:file "ffi-archive" :depends-on ("types" "library"))
                             (:file "ffi-entry"   :depends-on ("types" "library"))
                             (:file "raw-exports" :depends-on ("ffi-names" "constants"
                                                               "ffi-archive" "ffi-entry"))))))

(asdf:defsystem #:libarchive
  :description "Common Lisp interface to libarchive: read, write and extract tar, zip, 7z, cpio, iso9660 and more."
  :license     "MIT"
  :version     "0.3.1"
  :depends-on  (#:libarchive/ffi #:bordeaux-threads #:trivial-garbage #:babel
               ;; SBCL normalizes Unicode itself; only macOS needs it (entry.lisp).
               (:feature (:and :darwin (:not :sbcl)) #:uax-15))
  :components ((:module "src"
                :components ((:file "api-package")
                             (:file "core"      :depends-on ("api-package"))
                             (:file "registry"  :depends-on ("api-package"))
                             (:file "handle"    :depends-on ("core" "registry"))
                             ;; Every callback body goes through the guard in
                             ;; here; nothing may unwind through a C frame.
                             (:file "callbacks" :depends-on ("handle"))
                             (:file "entry"     :depends-on ("callbacks"))
                             (:file "options"   :depends-on ("handle"))
                             (:file "reader"    :depends-on ("callbacks" "entry" "options"))
                             (:file "writer"    :depends-on ("callbacks" "entry" "options"))
                             (:file "match"     :depends-on ("reader"))
                             (:file "disk"      :depends-on ("reader" "writer" "match"))
                             (:file "with"      :depends-on ("reader" "writer" "disk")))))
  :in-order-to ((asdf:test-op (asdf:test-op #:libarchive/tests))))

(asdf:defsystem #:libarchive/tests
  :description "Test suite for libarchive."
  :license     "MIT"
  :version     "0.3.1"
  :depends-on  (#:libarchive #:fiveam #:trivial-gray-streams #:bordeaux-threads)
  :components ((:module "tests"
                :serial t
                :components ((:file "package")
                             (:file "helpers")
                             (:file "symbol-tests")
                             (:file "entry-tests")
                             (:file "roundtrip-tests")
                             (:file "stream-tests")
                             (:file "callback-tests")
                             (:file "encryption-tests")
                             (:file "disk-tests")
                             (:file "match-tests")
                             (:file "fuzz-tests")
                             (:file "error-tests")
                             ;; Last: asserts on what the suites above left behind.
                             (:file "hygiene-tests"))))
  :perform (asdf:test-op (op c)
             (declare (ignore op c))
             ;; ASDF ignores what PERFORM returns; returning NIL would leave
             ;; `asdf:test-system' -- and so `make test' -- green on a failure.
             (unless (uiop:symbol-call :libarchive/tests '#:run-tests)
               (error "The libarchive test suite failed."))))

(asdf:defsystem #:libarchive/cli
  :description "la: extract, create, list and test archives of every kind libarchive knows."
  :license     "MIT"
  :version     "0.3.1"
  :depends-on  (#:libarchive #:clingon #:sb-posix)
  :components ((:module "cli"
                :components ((:file "package")
                             (:file "util"    :depends-on ("package"))
                             (:file "bundle"  :depends-on ("util"))
                             (:file "formats" :depends-on ("util"))
                             (:file "main"    :depends-on ("util" "bundle"))
                             ;; One file per command (list.lisp has l, t and i);
                             ;; each registers itself with main.lisp.
                             (:file "extract" :depends-on ("main" "formats"))
                             (:file "add"     :depends-on ("main" "formats" "extract"))
                             (:file "list"    :depends-on ("main" "extract"))
                             (:file "diff"    :depends-on ("main" "extract"))
                             (:file "remove"  :depends-on ("main" "add"))
                             (:file "convert" :depends-on ("main" "add"))
                             (:file "docs"    :depends-on ("main")))))
  :build-operation "program-op"
  :build-pathname  "bin/la"
  :entry-point     "libarchive/cli:main"
  ;; ASDF's own method, but compressed when this SBCL can: the image is about
  ;; three quarters of the binary, and zstd shrinks it to a quarter.
  :perform (asdf:program-op (o c)
             (uiop:dump-image (asdf:output-file o c)
                              :executable t
                              :compression (and (member :sb-core-compression *features*) t)))
  :in-order-to ((asdf:test-op (asdf:test-op #:libarchive/cli/tests))))

(asdf:defsystem #:libarchive/cli/tests
  :description "Tests for la, run in-process."
  :license     "MIT"
  :version     "0.3.1"
  :depends-on  (#:libarchive/cli #:fiveam)
  :components ((:module "cli-tests"
                :serial t
                :components ((:file "package")
                             (:file "cli-tests"))))
  :perform (asdf:test-op (op c)
             (declare (ignore op c))
             (unless (uiop:symbol-call :libarchive/cli/tests '#:run-tests)
               (error "The la test suite failed."))))
